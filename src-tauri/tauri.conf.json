{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WidgetForge",
  "version": "0.1.0",
  "identifier": "com.widgetforge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "hub",
        "title": "WidgetForge",
        "url": "hub.html",
        "width": 1000,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../widgets/": "widgets/"
    },
    "fileAssociations": [
      {
        "ext": [
          "forgewidget"
        ],
        "name": "WidgetForge widget",
        "description": "A WidgetForge widget package",
        "mimeType": "application/x-forgewidget",
        "role": "Viewer"
      }
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/mime/packages/widgetforge.xml": "mime/widgetforge.xml"
        }
      }
    }
  }
}
